                "value": ""
              }
            ],
            "params": [
              {
                "name": "mediaId",
                "value": "aHR0cHM6Ly9ob290c3VpdGUtdmlkZW8uczMuYW1hem9uYXdzLmNvbS9wcm9kdWN0aW9uLzEyMjU1MjQ0XzgyOTVmZjllLWFkOWYtNGNlNy1iOGE3LTgwNzI0NDAwYTBhZS5tcDQ=",
                "type": "path",
                "description": "The Media ID to retrieve"
              }
            ]
