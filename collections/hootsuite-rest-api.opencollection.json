                "description": "Your client ID found in the Hootsuite Developer Portal."
              },
              {
                "name": "scope",
                "value": "",
                "type": "query",
                "description": "The required token scopes. Include \"offline\" if you need a refresh token or \"analytics:read\" for analytics API access. Multiple scopes must be separated by spaces."
