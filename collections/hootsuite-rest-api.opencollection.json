                "value": ""
              }
            ],
            "params": [
              {
                "name": "messageId",
                "value": "4138476039",
                "type": "path",
                "description": "The message ID."
              }
            ]
          },
          "docs": "Deletes a message. A message is always associated with a single social profile."
        },
        {
          "info": {
            "name": "Approve message",
